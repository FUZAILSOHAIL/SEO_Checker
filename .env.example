# .env.example — copy to .env and fill in real values
# Never commit .env to version control.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_SETTINGS_MODULE=config.settings.development

ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/website_booster

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenAI
OPENAI_API_KEY=sk-...

# Google PageSpeed Insights API key (optional, free tier available)
GOOGLE_PAGESPEED_API_KEY=AIza...

# Public URL of this app (used to build OAuth redirect_uri & webhook address)
# In dev: use ngrok — e.g. https://abc123.ngrok.io
APP_BASE_URL=https://your-app.example.com
